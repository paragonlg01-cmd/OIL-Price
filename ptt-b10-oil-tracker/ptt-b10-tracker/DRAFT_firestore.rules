rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidSharedBoardState(data) {
      return data.keys().hasAll([
          'stateId',
          'defaultEvPrice',
          'selectedYear',
          'selectedMonth',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'stateId',
          'defaultEvPrice',
          'selectedYear',
          'selectedMonth',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.stateId is string &&
        data.stateId.size() >= 1 &&
        data.stateId.size() <= 64 &&
        data.stateId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.defaultEvPrice is string &&
        data.defaultEvPrice.size() >= 1 &&
        data.defaultEvPrice.size() <= 16 &&
        data.defaultEvPrice.matches('^[0-9]+(\\.[0-9]{1,2})?$') &&
        data.selectedYear is int &&
        data.selectedYear >= 2020 &&
        data.selectedYear <= 2035 &&
        data.selectedMonth is int &&
        data.selectedMonth >= 1 &&
        data.selectedMonth <= 12 &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /sharedBoardState/{stateId} {
      allow get: if isSignedIn() && isValidId(stateId) && (resource == null || existing().ownerId == request.auth.uid);

      allow create: if isSignedIn() &&
        isValidId(stateId) &&
        isValidSharedBoardState(incoming()) &&
        incoming().stateId == stateId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(stateId) &&
        isValidSharedBoardState(incoming()) &&
        incoming().stateId == existing().stateId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'defaultEvPrice',
            'selectedYear',
            'selectedMonth',
            'updatedAt'
          ])
        );

      allow delete: if isSignedIn() && isValidId(stateId) && existing().ownerId == request.auth.uid;
    }
  }
}
